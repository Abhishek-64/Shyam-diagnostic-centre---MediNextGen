/**
 * .sequelizerc
 *
 * Tells sequelize-cli where to find config, models, migrations, and seeders.
 * Uses CommonJS `require` because sequelize-cli does not support ES modules natively.
 * The config file exports an object compatible with sequelize-cli's expected format.
 */
const path = require('path');

module.exports = {
  config: path.resolve('src', 'config', 'sequelize-cli.cjs'),
  'models-path': path.resolve('src', 'database', 'models'),
  'migrations-path': path.resolve('src', 'database', 'migrations'),
  'seeders-path': path.resolve('src', 'database', 'seeders'),
};
