{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "echo 'Backend ready'",
    "start": "node src/server.js",
    "lint": "eslint src --ext .js --report-unused-disable-directives --max-warnings 0",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:status": "npx sequelize-cli db:migrate:status",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:migration:create": "npx sequelize-cli migration:generate --name",
    "db:init": "node src/scripts/init-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "nanoid": "^3.3.20",
    "nodemailer": "^10.1.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sequelize": "^6.37.5",
    "slugify": "^1.6.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "sequelize-cli": "^6.6.2"
  }
}
